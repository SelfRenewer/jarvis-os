# JARVIS configuration. Copy to `.env` and fill in real values (never commit `.env`).
# Generate local secrets with:  docker compose run --rm api jarvis gen-key   (or: uv run jarvis gen-key)

# --- runtime ------------------------------------------------------------------------------------
JARVIS_ENV=prod                          # dev | prod | test (test = every adapter is a fake)
LOG_LEVEL=INFO
LOG_JSON=true
# Compose sets DATABASE_URL for containers; this one is for running `uv run jarvis …` on the host.
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:55432/jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jarvis
# admin API bearer token (/api/v1/*)
JARVIS_API_TOKEN=
# Fernet key; required to store Google OAuth tokens
JARVIS_ENCRYPTION_KEY=
# https://jarvis.example.com — enables webhooks; empty = polling only
JARVIS_PUBLIC_BASE_URL=
# used by Caddy (compose profile "public")
JARVIS_DOMAIN=
JARVIS_API_BIND=127.0.0.1                # VPS: your Tailscale IP (100.x.y.z) so the Dev Worker can connect

# --- user ---------------------------------------------------------------------------------------
DEFAULT_USER_TIMEZONE=Asia/Tbilisi        # IANA name only
DEFAULT_USER_NAME=Алекс
# default departure address for travel-time estimates
DEFAULT_ORIGIN=
WORKING_HOURS_START=09:00
WORKING_HOURS_END=21:00
WORKING_DAYS=0,1,2,3,4,5,6                # 0 = Monday
SLEEP_START=23:30
SLEEP_END=07:30

# --- Todoist ------------------------------------------------------------------------------------
# Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=
# only for webhooks (App Console OAuth app)
TODOIST_CLIENT_ID=
# webhook HMAC key
TODOIST_CLIENT_SECRET=
TODOIST_RECONCILE_MINUTES=10

# --- Google Calendar ----------------------------------------------------------------------------
# Simplest: the calendar's secret iCal address (Google Calendar → Settings → Integrate calendar). It is a key to
# the whole calendar: keep it only here. Read-only; when set it wins over OAuth below.
GOOGLE_CALENDAR_ICS_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_IDS=primary               # comma-separated calendars used for availability
# optional; auto-detected by name "Todoist" and excluded
GOOGLE_TODOIST_CALENDAR_ID=
# Strategy B only
GOOGLE_MIRROR_CALENDAR_ID=
# push notification channel token
GOOGLE_CHANNEL_TOKEN=
CALENDAR_STRATEGY=native                  # native (Strategy A, recommended) | mirror (Strategy B)
CALENDAR_SYNC_DAYS=14
CALENDAR_RECONCILE_MINUTES=5

# --- Maps: travel time -------------------------------------------------------
MAPS_PROVIDER=auto                        # auto (Google if its key, else OpenRouteService) | google | openrouteservice
# free (no card): routing + address search; also feeds the 2GIS button
OPENROUTESERVICE_API_KEY=
MAPS_GEOCODE_COUNTRY=GE                   # addresses are searched in this country (empty = anywhere)
MAPS_GEOCODE_MAX_REQUESTS_PER_DAY=100     # OpenRouteService free: 1,000/day; results cached for 30 days
MAPS_2GIS_BASE_URL=https://2gis.ge/tbilisi # «🧭 Маршрут в 2ГИС» links
# optional, live traffic, needs billing; key restricted to Routes API
GOOGLE_MAPS_API_KEY=
MAPS_TRAVEL_MODE=DRIVE                    # DRIVE | WALK | BICYCLE | TRANSIT | TWO_WHEELER (Enterprise SKU)
MAPS_TRAFFIC_AWARE=true                   # live traffic for DRIVE = Compute Routes Pro; false = Essentials
MAPS_MAX_REQUESTS_PER_DAY=150             # routing/day; Google: 31 × 150 < 5,000 free Pro/month; ORS free: 2,000/day
USE_PREVIOUS_EVENT_LOCATION_AS_ORIGIN=true
LOCATION_ORIGIN_TTL_MINUTES=120           # a location sent in Telegram is the starting point this long

# --- Telegram -----------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# your numeric Telegram user id(s), comma-separated
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MODE=polling                     # polling | webhook (webhook needs JARVIS_PUBLIC_BASE_URL)
TELEGRAM_WEBHOOK_SECRET=

# --- LLM (text understanding only; Claude Code on the dev machine uses its own login) ---------------
LLM_PROVIDER=auto                         # auto (OpenRouter if its key is set) | openrouter | anthropic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5  # must support structured outputs (checked by `jarvis doctor`)
OPENROUTER_REASONING_EFFORT=low           # none|minimal|low|medium|high — lower = faster, cheaper
# per task: intent_router=…,idea_analyzer=…,spec_writer=…,product_matcher=…
OPENROUTER_MODELS=
LLM_ROUTER_TIMEOUT_SECONDS=12             # a chat message waits at most this long for the LLM router (0 = no limit)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5             # verified by `jarvis doctor`
ANTHROPIC_EFFORT=low
ANTHROPIC_ENABLE_FALLBACKS=true           # server-side refusal fallbacks ("default")
LLM_MAX_CALLS_PER_DAY=500

# --- Embeddings / speech-to-text (optional) -----------------------------------------------------
# Search by meaning («найди стрижку» → «Записаться к барберу»). auto = Voyage if VOYAGE_API_KEY, else OpenRouter
# if OPENROUTER_API_KEY, else local hashing (search by words only). Without vectors the search stays lexical.
EMBEDDINGS_PROVIDER=auto                  # auto | openrouter | voyage | hashing
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3    # must return 1024-d vectors; bge-m3: multilingual, $0.01 / 1M tokens
EMBEDDINGS_MAX_CALLS_PER_DAY=300          # one call = a batch of texts (backfill) or one search query
EMBEDDINGS_BATCH_SIZE=64
EMBEDDINGS_BACKFILL_MINUTES=10            # new/changed tasks, events, ideas, notes, purchases get vectors this often
SEARCH_MIN_SIMILARITY=0.55                # cosine floor for a hit found only by meaning (tune per model)
SEARCH_SIMILARITY_MARGIN=0.12             # …and at most this far below the best hit by meaning
SEARCH_EMBED_TIMEOUT_SECONDS=4            # a search waits at most this long, then answers by words only
# semantic embeddings (direct Voyage); empty = OpenRouter or lexical
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
# voice notes; empty = audio stored, not transcribed
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Voice calls --------------------------------------------------------------------------------
VOICE_CALLS_ENABLED=false                 # true = real (paid) phone calls from the reminder engine
# E.164, e.g. +15555550123
USER_PHONE_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# imported Twilio number inside Vapi
VAPI_PHONE_NUMBER_ID=
# Vapi server-URL credential (Bearer)
VAPI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MAX_CALLS_PER_DAY=6

# --- Reminders ----------------------------------------------------------------------------------
REMINDER_OFFSETS_MINUTES=30,8,0           # before departure
REMINDER_CALL_OFFSETS_MINUTES=0           # which of those use a phone call (if enabled)
REMINDER_TASK_OFFSETS_MINUTES=0           # timed Todoist tasks
REMINDER_TRAVEL_BUFFER_MINUTES=10
CALL_GRACE_SECONDS=300                    # never call later than this after the planned time
TELEGRAM_GRACE_SECONDS=1800

# --- Planner ------------------------------------------------------------------------------------
PLANNER_AUTO_APPLY=never                  # never | small | always
PLANNER_DEFAULT_DURATION_MINUTES=30
PLANNER_MIN_BREAK_MINUTES=10
PLANNER_HORIZON_DAYS=3
PLANNER_UNKNOWN_TRAVEL_MINUTES=30        # blocked before events with an address when travel time is unknown

# --- Chat manner, menu, weather -----------------------------------------------------------------
PERSONA_ENABLED=true                     # «Да, сэр», greetings by time of day
PERSONA_ADDRESS=сэр
MENU_KEYBOARD_ENABLED=true               # persistent buttons under the input field
WEATHER_ENABLED=true                     # Open-Meteo (free, no key)
WEATHER_PLACE=Тбилиси
WEATHER_LATITUDE=41.7151
WEATHER_LONGITUDE=44.8271
WEATHER_ALERTS_ENABLED=true              # "rain starts ~17:00" when the weather type changes (not at night)
WEATHER_ALERTS_PER_DAY=4

# --- Voice replies / voice notes (via OPENROUTER_API_KEY) ---------------------------------------
VOICE_REPLIES_ENABLED=true               # answer the user's messages with a voice note + text (chat: /voice off)
TTS_MODEL=x-ai/grok-voice-tts-1.0        # ≈$0.015 / 1000 chars; google/gemini-3.1-flash-tts-preview supports TTS_STYLE
TTS_VOICE=Rex                            # Grok: Rex, Leo, Sal, Eve, Ara
# Gemini only, e.g. [calm, composed, refined British butler manner]
TTS_STYLE=
TTS_MAX_CHARS=700                        # spoken part of one reply
TTS_MAX_CALLS_PER_DAY=300
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
STT_MAX_CALLS_PER_DAY=300

# --- Briefings (local time) ---------------------------------------------------------------------
BRIEFING_MORNING_ENABLED=true            # 08:00 day overview + plan proposal (replaces the bare daily plan)
BRIEFING_MORNING_AT=08:00
BRIEFING_EVENING_ENABLED=true            # 21:00 what is not done + buttons to move / mark done
BRIEFING_EVENING_AT=21:00
BRIEFING_GRACE_MINUTES=180               # a briefing later than this (Mac asleep) is skipped, not sent late

# --- Dev Worker (server side) -------------------------------------------------------------------
# shared with the dev machine
DEV_WORKER_TOKEN=
# shared with the dev machine (job HMAC)
DEV_WORKER_SIGNING_KEY=
# e.g. golden-app  (paths live only on the dev machine)
DEV_REPO_IDS=

# --- Shopping -----------------------------------------------------------------------------------
SHOPPING_CURRENCY=GEL
SHOPPING_EXTRA_DELIVERY_PENALTY=3.00
SHOPPING_SUBSTITUTION_PENALTY=1.50
SHOPPING_MIN_MATCH_CONFIDENCE=0.8

# --- Safety flags (keep false) ------------------------------------------------------------------
ALLOW_LIVE_CALL_TESTS=false
ALLOW_LIVE_CLAUDE_TESTS=false
ALLOW_LIVE_PURCHASES=false

RESEARCH_ENABLED=true                     # «изучи …»: web search via OpenRouter (Exa), only after a price button
# empty = OPENROUTER_MODEL
RESEARCH_MODEL=
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_PER_DAY=10
FINANCE_DEFAULT_CURRENCY=GEL              # expenses without a currency; totals are shown in it
MAC_NOTIFY_REMINDERS=true                 # reminders also pop up on the Mac while Jarvis for Mac is online
MAC_VOICE_REPLIES_ENABLED=true            # Jarvis for Mac speaks every reply (its own switch, separate from /voice)
REMINDER_ESCALATION_ENABLED=true          # repeat reminders until «👌 Понял» (instead of calls)
REMINDER_REPEAT_MINUTES=3,8,15            # minutes after the first message
REMINDER_ESCALATION_VOICE=true            # the first repeat also as a voice note

# --- CRM (Jarvis OS menu «CRM» and «открой CRM» go here; https only) ---
CRM_URL=https://crm.example.com/
# --- TLT / TPL tracker (LMF on the Mac, ~/Sites/TLT) ---
# LMF's API token (LMF writes it to app/data/api-token on start); `uv run jarvis lmf-setup` copies it here.
LMF_API_TOKEN=

# --- Watch and scale (Galaxy Watch / Xiaomi scale → Health Connect → Life Dashboard Companion on the phone) ---
# Signing secret of POST /webhooks/health (service `health`, home network, port HEALTH_HOST_PORT=8097).
# Generate: openssl rand -hex 32; the phone gets it from the QR code of `jarvis health-pair`.
HEALTH_WEBHOOK_SECRET=
# for BMI (openScale does not export height to Health Connect)
HEALTH_HEIGHT_CM=
HEALTH_WEIGHT_SOURCES=com.health.openscale.sync   # weighings offered to TLT only from these apps; empty = any
